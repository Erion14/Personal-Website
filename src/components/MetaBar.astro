<div class="meta-bar mono">
  <span>erionademi.com</span>
  <span class="meta-location">Prishtina, Kosovo</span>
  <time class="meta-clock" data-clock>--:--:--</time>
</div>

<style>
  .meta-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.65rem;
  }

  .meta-clock {
    font-variant-numeric: tabular-nums;
  }

  .meta-clock::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 0.5rem;
    vertical-align: middle;
    background-color: #ff4f3f;
  }

  @media (prefers-reduced-motion: no-preference) {
    .meta-clock::before {
      animation: blink 2s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .meta-location {
      display: none;
    }
  }
</style>

<script>
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  const format = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Belgrade',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    timeZoneName: 'short',
  });

  const update = () => {
    if (clock) clock.textContent = format.format(new Date());
  };
  update();
  setInterval(update, 1000);
</script>
