---
import Layout from '../layouts/Layout.astro';
import avatar from '../assets/erion.jpg';
import ParticleGenerator from '../components/ParticleGenerator.astro';
import { projects } from '../data/projects';
import '../styles/index.css';


const topProjects = projects.slice(0, 3);
---

<Layout>
  <main>
    <div class="container">
      <header>
        <img src={avatar.src} alt="Erion Ademi" class="avatar" />
        <div class="header-text">
          <h1>Erion Ademi</h1>
          <p>Software Developer</p>
        </div>
      </header>

      <section class="links-section">
        <h2>Links</h2>
        <div class="links-grid">
          <a href="https://github.com/Erion14">GitHub</a>
          <a href="https://www.linkedin.com/in/erion-ademi-b730a1230/">LinkedIn</a>
          <a href="/Erion_Ademi_CV.pdf" target="_blank" rel="noopener noreferrer">CV</a>
          <span>erionn.ademi@gmail.com</span>
        </div>
      </section>

    <section class="about-section">
      <h2>About me</h2>
      <p>
        I am a software developer who builds robust and scalable web applications.
      </p>
      <p>
        My work focuses on full-stack development with a strong emphasis on backend architecture.
      </p>
      <p>
       I use technologies like .NET Core and React to create highly functional systems that perform well under pressure.
      </p>
      <p>
        I am studying Computer Information and Technologies at RITK.
      </p>
      <p>
        Check out my <a href="/projects"><span>projects</span></a> to see what I am building.
      </p>
    </section>

      <section class="projects-section">
        <h2>Projects</h2>
        <div class="projects-list">
          {topProjects.map(project => (
            <a href={project.url} class="project-entry" target="_blank" rel="noopener noreferrer">
              <div class="project-info">
                <span class="project-name">{project.name}</span>
                <p class="project-description">{project.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
      <ParticleGenerator />

      <footer class="footer-section">
        <p>Website built using <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> • <a href="https://github.com/Erion14/Personal-Website" target="_blank" rel="noopener noreferrer">View source</a></p>
      </footer>
      
    </div>
  </main>
</Layout>
