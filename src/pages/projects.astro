---
import Layout from '../layouts/Layout.astro';
import MetaBar from '../components/MetaBar.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { projects } from '../data/projects';
import '../styles/projects.css';
---

<Layout>
  <main>
    <div class="container">
      <MetaBar />
      <section class="projects-intro">
        <h2 class="section-label mono" data-reveal><span class="accent">{String(projects.length).padStart(2, '0')}</span>/<span>Projects</span></h2>
        <p class="subtitle" data-reveal>Things I have built, newest first. Source for all of them is on <a href="https://github.com/Erion14" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
        <ProjectGrid projects={projects} />
      </section>
    </div>
  </main>
</Layout>
